{
  "version": 2,
  "buildCommand": "pnpm run vercel:build",
  "outputDirectory": "artifacts/cgv-snack-order/dist/public",
  "functions": {
    "api/index.js": {
      "includeFiles": "artifacts/api-server/dist/**"
    },
    "api/[...path].js": {
      "includeFiles": "artifacts/api-server/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}